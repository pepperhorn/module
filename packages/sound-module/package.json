{
  "name": "@pepperhorn/sound-module",
  "version": "0.1.1",
  "description": "Embeddable React sound module: a sampled-instrument rack with patch browser, on-screen piano, computer keyboard and Web MIDI input.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/embed/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/embed/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./patches/*": "./dist/patches/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/michroma": "^5.3.0",
    "smplr": "^0.20.0",
    "zustand": "^5.0.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
